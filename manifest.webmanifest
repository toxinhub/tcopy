{
  "id": "/tcopy/",
  "name": "tcopy — Paste here. Grab it anywhere.",
  "short_name": "tcopy",
  "description": "A clipboard-first notebook for the things you want to keep across devices.",
  "start_url": "/tcopy/",
  "scope": "/tcopy/",
  "display": "standalone",
  "background_color": "#f6f4ee",
  "theme_color": "#f6f4ee",
  "icons": [
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/tcopy/share/",
    "method": "POST",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
